# Optional application origin. Omit to use http://localhost:3000 locally.
APP_ORIGIN=http://localhost:3000
# Identity remains unavailable until all three settings are provided.
# Local mode requires BOTH origins to use loopback. Use the same app origin in the browser.
# APP_ENV=local
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_PUBLISHABLE_OR_ANON_KEY
# Local app + separate hosted Supabase test project (never production; no Docker needed).
# The URL's project reference must exactly match SUPABASE_TEST_PROJECT_REF.
# APP_ENV=local-cloud-test
# APP_ORIGIN=http://localhost:3000
# SUPABASE_URL=https://YOUR_20_CHARACTER_TEST_PROJECT_REF.supabase.co
# SUPABASE_TEST_PROJECT_REF=YOUR_20_CHARACTER_TEST_PROJECT_REF
# SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PROJECT_PUBLISHABLE_KEY
# No service-role/secret key belongs in the application environment.
# In APP_ENV=hosted, password sign-in remains disabled in the application. Global
# Supabase signup must be disabled; an approved existing Auth identity and profile are required.
# GOOGLE_OAUTH_ENABLED=false
# Set true only after the hosted Google provider and exact callback allowlist are configured.
# Optional desktop push: expose ONLY the public VAPID key to the app server.
# Generate stable local keys with npm run push:generate-local-keys; the ignored
# .env.push.local holds the private key for the separate trusted dispatcher.
# PUSH_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
# PUSH_VAPID_PRIVATE_KEY and PUSH_DATABASE_URL must NEVER be in browser env.

# HOSTED WEB PROCESS (inject as server environment, never as NEXT_PUBLIC_*):
# APP_ENV=hosted
# APP_ORIGIN=https://approved-college-host.example
# SUPABASE_URL=https://approved-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_HOSTED_PUBLISHABLE_KEY
# GOOGLE_OAUTH_ENABLED=true
# PUSH_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
#
# HOSTED CALENDAR PROCESS (separate protected environment file):
# APP_ENV=hosted
# ARKST_HOSTED_RUNNER_ENABLED=true
# SUPABASE_URL=https://approved-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_HOSTED_PUBLISHABLE_KEY
# ARKST_SCHEDULER_EMAIL=APPROVED_RESTRICTED_STAFF_EMAIL
# ARKST_SCHEDULER_PASSWORD=SET_IN_SECRET_STORE
#
# HOSTED PUSH PROCESS (separate protected environment file):
# APP_ENV=hosted
# PUSH_DISPATCH_ENABLED=true
# PUSH_DATABASE_HOST=APPROVED_EXACT_DATABASE_HOST
# PUSH_DATABASE_URL=postgresql://OPERATOR:SECRET@APPROVED_EXACT_DATABASE_HOST:5432/postgres
# PUSH_VAPID_PUBLIC_KEY=YOUR_PUBLIC_VAPID_KEY
# PUSH_VAPID_PRIVATE_KEY=SET_IN_SECRET_STORE
# PUSH_VAPID_SUBJECT=mailto:APPROVED_CONTACT@example.edu
#
# HOSTED TRUSTED ADMIN PROCESS ONLY, never the web or browser environment:
# APP_ENV=hosted
# ARKST_HOSTED_ADMIN_ENABLED=true
# ADMIN_DATABASE_URL=postgresql://OPERATOR:SECRET@APPROVED_EXACT_DATABASE_HOST:5432/postgres
# Pass --database-host APPROVED_EXACT_DATABASE_HOST with every operator command.
